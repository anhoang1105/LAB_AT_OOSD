        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n:Chọn &#39;Cập nhật danh mục sách&#39;;\n:Hiển thị danh sách tài liệu hiện tại;\n:Chọn hành động Thêm/Sửa/Xóa;\nif (Hành động là Xóa?) then (Có)\n  if (Sách đang có người mượn?) then (Có)\n    :Chặn thao tác &amp; Báo lỗi;\n    stop\n  else (Không)\n    :Xóa dữ liệu sách;\n    :Cập nhật thành công;\n    stop\n  endif\nelse (Không)\n  repeat\n    :Nhập thông tin cập nhật;\n    if (Thiếu thông tin bắt buộc?) then (Có)\n      :Báo lỗi yêu cầu hoàn thiện;\n    else (Không)\n      :Lưu vào CSDL;\n      :Cập nhật thành công;\n      stop\n    endif\n  repeat while (Nhập lại?) is (Có)\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VcdrYJhsKwHFD95YwO8M-321">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Cấu hình để chống đè chéo các node\nleft to right direction\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 70\nskinparam class {\n    BackgroundColor LightYellow\n    BorderColor DarkRed\n    ArrowColor DarkRed\n}\nhide circle\nhide empty members\n\nentity \&quot;KhachHang\&quot; {\n  * MaKH : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenKhachHang : nvarchar(150)\n  DiaChi : nvarchar(250)\n  DienThoai : varchar(20)\n}\n\nentity \&quot;HopDongThue\&quot; {\n  * SoHopDong : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaKH : varchar(20) &lt;&lt;FK&gt;&gt;\n  NgayLap : date\n  ThoiHanThue : int\n  TienDatCoc : decimal(18,2)\n  NgayKetThuc : date\n  TrangThai : nvarchar(50)\n}\n\nentity \&quot;PhieuGiaHan\&quot; {\n  * MaGiaHan : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  SoHopDong : varchar(20) &lt;&lt;FK&gt;&gt;\n  ThoiGianGiaHan : int\n  NgayLap : date\n}\n\nentity \&quot;ChiTietHopDong\&quot; {\n  * SoHopDong : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  * MaPhong : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  --\n  DonGiaThue : decimal(18,2)\n}\n\nentity \&quot;Tang\&quot; {\n  * MaTang : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenTang : nvarchar(100)\n}\n\nentity \&quot;Phong\&quot; {\n  * MaPhong : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaTang : varchar(20) &lt;&lt;FK&gt;&gt;\n  DienTich : decimal(18,2)\n  Huong : nvarchar(50)\n  GiaCoSo : decimal(18,2)\n  TrangThai : nvarchar(50)\n}\n\nentity \&quot;HoaDonPhong\&quot; {\n  * MaHDP : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  SoHopDong : varchar(20) &lt;&lt;FK&gt;&gt;\n  ThangNam : varchar(10)\n  SoTien : decimal(18,2)\n  DaThanhToan : bit\n}\n\nentity \&quot;SuDungDichVu\&quot; {\n  * MaDV : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  * MaPhong : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  * ThangNam : varchar(10) &lt;&lt;PK&gt;&gt;\n  --\n  ChiSoDau : int\n  ChiSoCuoi : int\n  TieuThu : int\n  ThanhTien : decimal(18,2)\n  DaThanhToan : bit\n}\n\nentity \&quot;NhanVien\&quot; {\n  * MaNV : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaPhong : varchar(20) &lt;&lt;FK&gt;&gt;\n  HoTen : nvarchar(150)\n  ChucVu : nvarchar(100)\n  CongTy : nvarchar(150)\n}\n\nentity \&quot;TheGiuXe\&quot; {\n  * MaThe : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  BienSoXe : varchar(20)\n  LoaiXe : nvarchar(50)\n}\n\n&#39; Định nghĩa mối quan hệ\nKhachHang ||--o{ HopDongThue\nHopDongThue ||--o{ PhieuGiaHan\nHopDongThue ||--|{ ChiTietHopDong\nHopDongThue ||--o{ HoaDonPhong\n\nTang ||--o{ Phong\nPhong ||--o{ ChiTietHopDong\nPhong ||--o{ SuDungDichVu\nPhong ||--o{ NhanVien\n\nNhanVien ||--|| TheGiuXe\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="70g5ATXiHnD62Jr3f1cw-547">

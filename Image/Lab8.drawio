        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam maxMessageSize 150\nactor \&quot;: NV kinh doanh\&quot; as NVKD\nboundary \&quot;: FrmGiaHan\&quot; as Frm\ncontrol \&quot;: GiaHanService\&quot; as Svc\nentity \&quot;: HopDongThue\&quot; as HD\nentity \&quot;: HoaDon\\n(Phong &amp; DichVu)\&quot; as HoaDon\nentity \&quot;: PhieuGiaHan\&quot; as PGH\n\nNVKD -&gt; Frm : Mo form \&quot;Gia han hop dong\&quot;\nNVKD -&gt; Frm : Nhap/Chon SoHopDong, ThoiGianGiaHan (thang)\nNVKD -&gt; Frm : Nhan \&quot;Lap phieu gia han\&quot;\nactivate Frm\n\nFrm -&gt; Svc : LapPhieuGiaHan(SoHopDong, ThoiGianGiaHan)\nactivate Svc\n\nSvc -&gt; HD : layThoiHanThueGoc(SoHopDong)\nHD --&gt; Svc : ThoiHanThue\nSvc -&gt; Svc : Kiem tra (ThoiGianGiaHan &lt;= ThoiHanThue / 2)\n\nalt [Thoi gian vuot muc]\n    Svc --&gt; Frm : KetQuaXuLy.Fail(\&quot;Thoi gian gia han toi da = 1/2 thoi gian goc\&quot;)\nelse [Thoi gian hop le]\n    \n    Svc -&gt; HoaDon : kiemTraCongNo(SoHopDong)\n    HoaDon --&gt; Svc : TongNoTienPhong, TongNoDichVu\n    \n    alt [TongNoTienPhong &gt; 0 hoac TongNoDichVu &gt; 0]\n        Svc --&gt; Frm : KetQuaXuLy.Fail(\&quot;Khong the gia han vi con no tien phong/dich vu\&quot;)\n    else [Khong no, chay trong 1 Transaction]\n        Svc -&gt; PGH : lapPhieuGiaHan(MaGiaHan, SoHopDong, ThoiGianGiaHan)\n        Svc -&gt; HD : capNhatHanHopDongMoi()\n        Svc -&gt; Svc : Commit()\n        Svc --&gt; Frm : KetQuaXuLy.Ok(\&quot;Gia han thanh cong\&quot;)\n    end\nend\n\ndeactivate Svc\nFrm --&gt; NVKD : Thong bao ket qua cho NV\ndeactivate Frm\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="70g5ATXiHnD62Jr3f1cw-31">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam ActivityBackgroundColor LightYellow\nskinparam ActivityBorderColor DarkRed\n\nstart\n:NV tiếp nhận yêu cầu thuê văn phòng;\nif (Khách chốt &gt;= 6 tháng?) then (Đúng)\n    :Lập hợp đồng thuê văn phòng (Transaction);\n    :Khách thanh toán 100% 6 tháng đầu;\n    :Cập nhật Trạng thái phòng: \&quot;Đã thuê\&quot;;\n    \n    fork\n        repeat\n            :Chu kỳ đầu mỗi tháng (từ tháng 7);\n            :Phát hành Hóa đơn tiền phòng;\n            :Thu tiền thuê phòng hàng tháng;\n        repeat while (Còn hạn hợp đồng?) is (Còn)\n    fork again\n        repeat\n            :Chu kỳ cuối mỗi tháng;\n            :Ghi nhận chỉ số dịch vụ (Kỹ thuật);\n            :Thu tiền điện, nước, internet;\n        repeat while (Phòng còn sử dụng?) is (Còn)\n    end fork\n    \n    :Hết hạn hợp đồng gốc;\n    \n    if (Khách yêu cầu gia hạn?) then (Có)\n        if (Nợ phòng == 0 &amp;&amp; Nợ DV == 0?) then (Sạch nợ)\n            if (Tháng gia hạn &lt;= 1/2 Tháng gốc?) then (Hợp lệ)\n                :Lập Phiếu gia hạn (Transaction);\n                :Cập nhật ngày kết thúc mới;\n            else (Không hợp lệ)\n                :Từ chối: Gia hạn vượt quá 1/2 thời gian;\n            endif\n        else (Còn nợ)\n            :Từ chối: Yêu cầu thanh toán dứt điểm công nợ;\n        endif\n    else (Không)\n        :Thanh lý hợp đồng &amp; Trả phòng;\n    endif\nelse (Sai quy định)\n    :Từ chối: Hợp đồng tối thiểu 6 tháng;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="70g5ATXiHnD62Jr3f1cw-336">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

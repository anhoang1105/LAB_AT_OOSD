        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam maxMessageSize 150\nactor \&quot;: NV kinh doanh\&quot; as NVKD\nboundary \&quot;: FrmHopDong\&quot; as Frm\ncontrol \&quot;: HopDongService\&quot; as Svc\nentity \&quot;: Phong\&quot; as P\nentity \&quot;: KhachHang\&quot; as KH\nentity \&quot;: HopDongThue\&quot; as HD\n\nNVKD -&gt; Frm : Nhap thong tin KH, thoi han thue (&gt;=6)\nNVKD -&gt; Frm : Chon danh sach phong thue\nNVKD -&gt; Frm : Nhan \&quot;Lap hop dong\&quot;\nactivate Frm\n\nFrm -&gt; Svc : LapHopDong(KH_Info, ListMaPhong, ThoiHanThue)\nactivate Svc\n\nSvc -&gt; Svc : Kiem tra (ThoiHanThue &gt;= 6)\nalt [ThoiHanThue &lt; 6]\n    Svc --&gt; Frm : KetQuaXuLy.Fail(\&quot;Thoi han thue toi thieu phai la 6 thang\&quot;)\nelse [Thoi han hop le - trong 1 Transaction]\n    \n    loop [Moi phong trong danh sach]\n        Svc -&gt; P : kiemTraTrangThai(MaPhong)\n        P --&gt; Svc : TrangThai = \&quot;Trong\&quot;\n        Svc -&gt; P : layGiaCoSo()\n    end\n    \n    Svc -&gt; Svc : Tinh tong tien 6 thang dau = Sum(GiaThue * 6)\n    \n    Svc -&gt; KH : luuHoacCapNhatKhachHang()\n    Svc -&gt; HD : lapHopDongVaChiTiet(SoHopDong, DanhSachPhong)\n    \n    loop [Moi phong trong danh sach]\n        Svc -&gt; P : capNhatTrangThai(\&quot;Da thue\&quot;)\n    end\n    \n    Svc -&gt; Svc : Commit()\n    Svc --&gt; Frm : KetQuaXuLy.Ok(\&quot;Hop dong thanh cong. Yeu cau thu tien 6 thang\&quot;)\nend\n\ndeactivate Svc\nFrm --&gt; NVKD : Thong bao va hien thi Form thu tien\ndeactivate Frm\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="70g5ATXiHnD62Jr3f1cw-80">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nhide circle\nskinparam class {\n    BackgroundColor LightYellow\n    BorderColor DarkRed\n    ArrowColor DarkRed\n}\n\nclass Phong {\n    MaPhong : String\n    DienTich : Decimal\n    Huong : String\n    GiaCoSo : Decimal\n    TrangThai : String\n    tinhGiaThue() : Decimal\n    capNhatTrangThai(tt: String)\n}\n\nclass KhachHang {\n    MaKH : String\n    TenKhachHang : String\n    DiaChi : String\n    DienThoai : String\n    luuHoacCapNhat()\n}\n\nclass HopDongThue {\n    SoHopDong : String\n    NgayLap : Date\n    NgayKetThuc : Date\n    ThoiHanThue : Integer\n    lapHopDong()\n    layThoiHanThueGoc() : Integer\n    capNhatHanHopDongMoi(ngayMoi: Date)\n}\n\nclass ChiTietHopDong {\n    SoHopDong : String\n    MaPhong : String\n    DonGiaThue : Decimal\n    themChiTiet()\n}\n\nclass PhieuGiaHan {\n    MaGiaHan : String\n    ThoiGianGiaHan : Integer\n    NgayLap : Date\n    lapPhieu()\n}\n\nclass HoaDonPhong {\n    MaHDP : String\n    ThangNam : String\n    SoTien : Decimal\n    DaThanhToan : Boolean\n    kiemTraNoTienPhong() : Decimal\n    thanhToanTienPhong()\n}\n\nclass SuDungDichVu {\n    MaDV : String\n    MaPhong : String\n    ThangNam : String\n    ChiSoDau : Integer\n    ChiSoCuoi : Integer\n    ThanhTien : Decimal\n    DaThanhToan : Boolean\n    kiemTraNoDichVu() : Decimal\n    chotChiSo()\n}\n\nclass NhanVien {\n    MaNV : String\n    HoTen : String\n    ChucVu : String\n    CongTy : String\n    themNhanVien()\n}\n\nclass TheGiuXe {\n    MaThe : String\n    BienSoXe : String\n    LoaiXe : String\n    capTheXe()\n}\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongThue\nHopDongThue \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHopDong\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonPhong\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; SuDungDichVu\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nNhanVien \&quot;1\&quot; -- \&quot;1..*\&quot; TheGiuXe\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="70g5ATXiHnD62Jr3f1cw-242">

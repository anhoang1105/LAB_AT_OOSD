        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nscale 1.0\nskinparam state {\n  BackgroundColor LightYellow\n  BorderColor DarkRed\n}\nskinparam defaultFontSize 12\nskinparam nodesep 80\nskinparam ranksep 80\n\n[*] --&gt; DangThuViec : LapQuyetDinhTuyenDung()\\n[da xep phong ban, luong]\n\nstate \&quot;Dang thu viec\&quot; as DangThuViec {\n  DangThuViec : entry/ luu quyet dinh, ghi ro thoi gian, luong thu viec\n  DangThuViec : do/ danh gia nang luc tai phong ban\n}\n\nstate \&quot;Da ky hop dong (Chinh thuc)\&quot; as DaKyHopDong {\n  DaKyHopDong : entry/ luu hop dong, lap QĐ chuc vu, lap QĐ luong\n  DaKyHopDong : do/ tinh luong hằng tháng\n}\n\nstate \&quot;Da nghi viec\&quot; as DaNghiViec {\n  DaNghiViec : entry/ vo hieu hoa ho so, chot luong\n}\n\nDangThuViec --&gt; DaKyHopDong : KyHopDong()\\n[dat yeu cau]\nDangThuViec --&gt; DaNghiViec : Huy()\\n[khong dat]\n\nDaKyHopDong --&gt; DaNghiViec : HuyHopDong()\\nhoac when(HetHan)\n\nDaNghiViec --&gt; [*]\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SpImEfP6JS1r9dkMB10Z-281">

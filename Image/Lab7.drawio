        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nscale 0.85\nhide circle\nskinparam linetype ortho\nskinparam defaultFontSize 11\nskinparam nodesep 50\nskinparam ranksep 50\nskinparam class {\n  BackgroundColor LightYellow\n  BorderColor DarkRed\n}\n\nentity \&quot;PhongBan\&quot; as PhongBan {\n  * MaPB : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenPhongBan : nvarchar(100)\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  * MaNV : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaPB : varchar(20) &lt;&lt;FK&gt;&gt;\n  HoTen : nvarchar(100)\n  DiaChi : nvarchar(250)\n  DienThoai : varchar(20)\n  NgayVaoLam : date\n}\n\nentity \&quot;QuyetDinhTuyenDung\&quot; as QuyetDinhTuyenDung {\n  * SoQDTD : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  NgayBatDau : date\n  NgayKetThuc : date\n  LuongThuViec : decimal(18,2)\n}\n\nentity \&quot;HopDong\&quot; as HopDong {\n  * SoHD : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  LoaiHD : nvarchar(50)\n  NgayKy : date\n  TrangThai : nvarchar(50)\n  ThoiHan : int\n}\n\nentity \&quot;HoSoBaoHiem\&quot; as HoSoBaoHiem {\n  * SoBH : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * SoHD : varchar(20) &lt;&lt;FK&gt;&gt;\n  LoaiBH : nvarchar(50)\n  MucDong : decimal(18,2)\n}\n\nentity \&quot;BangChamCong\&quot; as BangChamCong {\n  * MaBCC : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  Thang : int\n  Nam : int\n  TongGioLam : decimal(5,2)\n}\n\nentity \&quot;PhieuPhuTroi\&quot; as PhieuPhuTroi {\n  * SoPhieuPT : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  NgayPhuTroi : date\n  HinhThuc : nvarchar(50)\n}\n\nentity \&quot;ChiTietPhuTroi\&quot; as ChiTietPhuTroi {\n  * SoPhieuPT : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  * MaNV : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  --\n  SoGio : decimal(5,2)\n}\n\nentity \&quot;QDKhenThuongKyLuat\&quot; as QDKhenThuongKyLuat {\n  * SoQDKTKL : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  LoaiQD : nvarchar(20)\n  SoTien : decimal(18,2)\n  NgayKy : date\n}\n\nentity \&quot;PhieuThuChi\&quot; as PhieuThuChi {\n  * SoPhieuTC : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * SoQDKTKL : varchar(20) &lt;&lt;FK&gt;&gt;\n  LoaiPhieu : nvarchar(20)\n  SoTien : decimal(18,2)\n  NgayLap : date\n}\n\nentity \&quot;BangLuong\&quot; as BangLuong {\n  * MaBL : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNV : varchar(20) &lt;&lt;FK&gt;&gt;\n  Thang : int\n  Nam : int\n  TongThuNhap : decimal(18,2)\n  TongKhauTru : decimal(18,2)\n  ThucLanh : decimal(18,2)\n}\n\nPhongBan ||--o{ NhanVien\nNhanVien ||--o{ QuyetDinhTuyenDung\nNhanVien ||--o{ HopDong\nHopDong ||--o| HoSoBaoHiem\nNhanVien ||--o{ BangChamCong\nNhanVien ||--o{ ChiTietPhuTroi\nPhieuPhuTroi ||--|{ ChiTietPhuTroi\nNhanVien ||--o{ QDKhenThuongKyLuat\nQDKhenThuongKyLuat ||--o| PhieuThuChi\nNhanVien ||--o{ BangLuong\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SpImEfP6JS1r9dkMB10Z-599">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

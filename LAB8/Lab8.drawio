        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nskinparam usecase {\n    BackgroundColor LightYellow\n    BorderColor DarkRed\n}\nskinparam actor {\n    BackgroundColor White\n    BorderColor DarkRed\n}\n\nactor \&quot;NV Kinh doanh\&quot; as NVKD\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;NV Kỹ thuật\&quot; as NVKT\n\nrectangle \&quot;Phân rã Use Case: Ký hợp đồng đến Thanh toán &amp; Gia hạn\&quot; {\n    \n    usecase \&quot;Lập hợp đồng thuê văn phòng\&quot; as UC1\n    usecase \&quot;Thu tiền thuê 6 tháng đầu\&quot; as UC2\n    \n    usecase \&quot;Thu tiền thuê phòng hàng tháng\\n(từ tháng thứ 7)\&quot; as UC3\n    \n    usecase \&quot;Ghi nhận chỉ số dịch vụ cuối tháng\&quot; as UC4\n    usecase \&quot;Thu tiền dịch vụ\\n(điện, nước, internet)\&quot; as UC5\n    \n    usecase \&quot;Lập phiếu gia hạn hợp đồng\&quot; as UC6\n    usecase \&quot;Kiểm tra điều kiện gia hạn\\n(Không nợ tiền phòng &amp; dịch vụ)\&quot; as UC7\n}\n\n&#39; Liên kết Actor\nNVKD -- UC1\nNVKD -- UC6\n\nKT -- UC3\nKT -- UC5\n\nNVKT -- UC4\n\n&#39; Quan hệ bao hàm và mở rộng chuẩn bài mẫu\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC5 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC7 : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="58duU4HDqGcYYZtxKKyU-95">

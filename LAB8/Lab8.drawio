        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam classAttributeIconSize 0\nhide circle\n\nskinparam class {\n    BackgroundColor LightYellow\n    BorderColor DarkRed\n    ArrowColor DarkRed\n}\n\nclass Tang {\n    MaTang\n    TenTang\n    themTang()\n}\n\nclass Phong {\n    MaPhong\n    DienTich\n    Huong\n    GiaCoSo\n    TrangThai\n    tinhGiaThue()\n    capNhatTrangThai()\n}\n\nclass KhachHang {\n    MaKH\n    TenKhachHang\n    DiaChi\n    DienThoai\n    luuThongTin()\n}\n\nclass HopDongThue {\n    SoHopDong\n    NgayLap\n    ThoiHanThue\n    TienDatCoc\n    lapHopDong()\n    tinhTien6ThangDau()\n}\n\nclass ChiTietHopDong {\n    SoHopDong\n    MaPhong\n    DonGiaThue\n}\n\nclass PhieuGiaHan {\n    MaGiaHan\n    ThoiGianGiaHan\n    NgayLap\n    lapPhieuGiaHan()\n    kiemTraDieuKien()\n}\n\nclass HoaDonPhong {\n    MaHDP\n    ThangNam\n    SoTien\n    thanhToanTienPhong()\n}\n\nclass DichVu {\n    MaDV\n    TenDV\n    DonGia\n}\n\nclass SuDungDichVu {\n    ThangNam\n    ChiSoDau\n    ChiSoCuoi\n    TieuThu\n    ThanhTien\n    chotChiSo()\n}\n\nclass NhanVien {\n    MaNV\n    HoTen\n    ChucVu\n    CongTy\n    themNhanVien()\n}\n\nclass TheGiuXe {\n    MaThe\n    BienSoXe\n    LoaiXe\n    capTheXe()\n}\n\nclass KiemTraDinhKy {\n    MaKT\n    NgayKiemTra\n    BienBanViPham\n    TienPhat\n    lapLichKiemTra()\n}\n\n&#39; Liên kết cấu trúc tầng - phòng - hợp đồng\nTang \&quot;1\&quot; *-- \&quot;1..*\&quot; Phong : chứa\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong : thuộc\nHopDongThue \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHopDong : bao gồm\nKhachHang \&quot;1\&quot; -- \&quot;1..*\&quot; HopDongThue : ký kết\n\n&#39; Liên kết gia hạn và hóa đơn tiền phòng\nHopDongThue \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuGiaHan : gia hạn\nHopDongThue \&quot;1\&quot; --&gt; \&quot;0..*\&quot; HoaDonPhong : phát sinh\n\n&#39; Liên kết dịch vụ cao ốc\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; SuDungDichVu : sử dụng\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; SuDungDichVu : áp dụng cho\n\n&#39; Liên kết nhân sự và thẻ xe\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien : làm việc tại\nNhanVien \&quot;1\&quot; -- \&quot;1\&quot; TheGiuXe : sở hữu\n\n&#39; Liên kết kiểm định kỹ thuật\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; KiemTraDinhKy : kiểm tra định kỳ\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="58duU4HDqGcYYZtxKKyU-951">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
